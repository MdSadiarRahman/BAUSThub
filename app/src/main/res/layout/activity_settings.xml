<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="-8dp"
                android:text="Workspace\nSettings"
                android:textColor="#1E293B"
                android:textSize="42sp"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.05"
                android:text="REFINE IDENTITY &amp; SECURITY"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_toggle_container"
                android:orientation="horizontal"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tabProfile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_toggle_active"
                    android:gravity="center"
                    android:text="PROFILE DETAILS"
                    android:textColor="#1B7C43"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="CHANGE\nPASSWORD"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Profile Picture Section -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivSettingsProfilePic"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="@color/baust_yellow"
                    app:strokeWidth="3dp" />

                <ImageButton
                    android:id="@+id/btnSettingsUploadPic"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignBottom="@id/ivSettingsProfilePic"
                    android:layout_alignEnd="@id/ivSettingsProfilePic"
                    android:background="@drawable/circle_green"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@color/white" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="CHANGE PROFILE PHOTO"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Full Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:letterSpacing="0.05"
                android:text="FULL IDENTITY NAME"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSettingsName"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_input"
                android:hint="Full Name"
                android:paddingHorizontal="24dp"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:inputType="textPersonName" />

            <!-- Bio -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.05"
                android:text="THE HUB BIOGRAPHY"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSettingsBio"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_input"
                android:gravity="top"
                android:hint="Tell the campus about yourself..."
                android:padding="24dp"
                android:textColor="#64748B"
                android:textSize="16sp" />

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiscard"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F1F5F9"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="DISCARD"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="30dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmChanges"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1.5"
                    android:backgroundTint="@color/baust_green"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="CONFIRM CHANGES"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="30dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>